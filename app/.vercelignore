# Prevent build-time artifacts from inflating Python function bundles
node_modules
frontend/node_modules
frontend/.vite

# Local Python envs/caches
.venv
venv
__pycache__
*.pyc

# Build/runtime metadata
.vercel

# Docs and local-only tooling not needed at runtime
docs
scripts
*.log

# Frontend-only project: the SPA calls the Fly backend directly via
# VITE_API_URL, so the Python serverless functions are not deployed here.
# Excluding them avoids heavy Python bundles and broken /api/* on Vercel.
api
backend
database
nginx
