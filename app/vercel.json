{
  "framework": null,
  "installCommand": "echo 'install handled by buildCommand'",
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && rm -rf frontend/node_modules",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://talkbox.fly.dev/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
