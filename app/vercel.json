{
  "installCommand": "echo 'install handled by buildCommand'",
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && rm -rf frontend/node_modules",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/src/**,database/**}"
    },
    "api/kiosk/call/index.py": {
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/kiosk/call/(.*)", "destination": "/api/kiosk/call/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
