# ───── Postgres (pgvector) ─────
POSTGRES_DB=talkbox
POSTGRES_USER=talkbox
POSTGRES_PASSWORD=change-me

# ───── LLM provider ─────
# openai | bedrock
LLM_PROVIDER=openai
MODEL=gpt-4o-mini
MODEL_TEMPERATURE=0.0

# OpenAI — required when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=

# Embeddings backend: openai | bedrock
# Changing providers invalidates the pgvector dimensions — rotate COLLECTION_NAME
# when switching, or drop the existing langchain_pg_* tables.
EMBEDDINGS_PROVIDER=openai
# openai default: text-embedding-3-small (1536 dim)
# bedrock options: amazon.titan-embed-text-v2:0 (1024), cohere.embed-english-v3 (1024)
EMBEDDINGS_MODEL=text-embedding-3-small
COLLECTION_NAME=query_categories
# Agency facts are embedded separately. Rotate this name for every rebuilt
# catalog/model version, validate it, then switch readers deliberately.
AGENCY_COLLECTION_NAME=agency_catalog_v1
# vector | lexical. Vector mode falls back to lexical matching if the active
# agency collection is unavailable or does not map to the current FSC snapshot.
RESOURCE_SEARCH_MODE=vector

# AWS Bedrock — required when LLM_PROVIDER=bedrock or EMBEDDINGS_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ───── Database ─────
DB_URI=postgresql+psycopg://talkbox:change-me@talkbox-postgres:5432/talkbox
DB_NAME=sacramento
DB_TABLE_NAME=sacramento

# ───── Canonical FSC public resource synchronization ─────
# Published FSC Resource Platform origin, without a trailing /api path.
# These FSC credentials belong on the central Fly backend. Do not put them on
# a physical kiosk; kiosks will use a separate scoped Fly snapshot credential.
FSC_RESOURCE_API_BASE_URL=
# Service-to-service bearer credential. Store as a Fly secret in production.
FSC_RESOURCE_API_KEY=
FSC_RESOURCE_SYNC_ENABLED=true
FSC_RESOURCE_SYNC_INTERVAL_SECONDS=60
FSC_RESOURCE_REQUEST_TIMEOUT_SECONDS=10
# Persist the validated central snapshot across backend restarts. Local Docker
# already mounts the backend-data volume at /data.
FSC_RESOURCE_CACHE_PATH=/data/resource-snapshot.sqlite3
# Client-appliance role only: download the public snapshot from TalkBox on Fly.
# The scoped key is distinct from FSC_RESOURCE_API_KEY and can be revoked per
# client deployment. Leave these empty on the central Fly backend.
TALKBOX_CENTRAL_API_BASE_URL=
TALKBOX_CLIENT_SNAPSHOT_KEY=
# Central Fly role only: comma-separated client credentials accepted by the
# snapshot endpoint. Rotate clients independently; never put FSC keys here.
TALKBOX_SNAPSHOT_PUBLISH_KEYS=
# Warn when the last successful snapshot is older than this. A stale
# last-known-good snapshot remains usable during an upstream outage.
FSC_RESOURCE_CACHE_MAX_AGE_SECONDS=86400

# ───── Observability ─────
LOG_FILE=app.log
LOG_LEVEL=info

# ───── HTTP / CORS ─────
CORS_ORIGINS=*
# Loopback-only host port for backend diagnostics. nginx uses container port
# 8000 internally, so changing this does not change the browser API route.
BACKEND_HOST_PORT=8085
# Loopback-only host port for the local client UI.
FRONTEND_HOST_PORT=8084

# ───── Auth (fastapi-users, cookie JWT) ─────
# Rotate before first real deploy; generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Set to 1 behind HTTPS, 0 for plain-HTTP local dev
COOKIE_SECURE=1
# URL shown in future verify/reset emails
FRONTEND_URL=http://localhost:8084

# Admin user bootstrap (seeded on first boot, idempotent)
# Must be a real-looking email: pydantic EmailStr rejects .local/.test/.invalid TLDs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin
ADMIN_COMPANY=

# ───── Twilio (SMS webhook + outbound kiosk calls — optional) ─────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Browser Voice SDK (two-way calling from the kiosk browser):
#   1. Create a TwiML App in Twilio Console → Voice → TwiML Apps
#      Set its "A call comes in" URL to https://<your-public-host>/api/kiosk/call/twiml
#   2. Copy the TwiML App SID (APxxxxxxx) and your public URL below.
#   3. Create an API Key in Console → Account → API keys & tokens (Standard).
#      A real API Key (SKxxxxxxx) + secret is REQUIRED — Twilio rejects Voice
#      access tokens signed with the account SID/auth token (error 20101).
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PUBLIC_URL=
# Enable real outbound calls from the kiosk Dial tab (numbers must be in the
# agencies DB allowlist, or match KIOSK_TEST_CALL_NUMBER).
KIOSK_CALLING_ENABLED=false
# Comma-separated list of E.164 numbers allowed outside the DB allowlist.
# On Twilio trial accounts, only verified numbers can be called.
KIOSK_TEST_CALL_NUMBERS=

# ───── Kiosk (keypad-first 6-inch UX) ─────
# When true, /api/kiosk/query returns curated sample resources instead of
# calling OpenAI + pgvector. Lets the kiosk demo run with no API key / seeded DB.
KIOSK_MOCK_QUERY=false
# Seconds of inactivity before the kiosk auto-resets to the idle menu.
KIOSK_IDLE_RESET_SECONDS=60
# Seconds of no keypad activity during a live call before the kiosk asks
# "are you still there?" (two warnings ~45s apart, then auto-hangup).
KIOSK_CALL_IDLE_WARN_SECONDS=300
# Seconds of no activity before the idle screen dims (burn-in protection).
# Any key wakes it instantly.
KIOSK_SCREEN_DIM_SECONDS=1800

# ───── Kiosk speech search (optional local-first STT) ─────
KIOSK_STT_ENABLED=true
# local | openai | auto
KIOSK_STT_PROVIDER=local
KIOSK_STT_MODEL_PATH=/models/ggml-tiny.en-q5_1.bin
KIOSK_STT_WHISPER_BIN=/usr/local/bin/whisper-cli
KIOSK_STT_MAX_SECONDS=6
KIOSK_STT_LANGUAGE=en
# whisper-1 is more robust for quiet mic input than gpt-4o-mini-transcribe
KIOSK_STT_OPENAI_MODEL=whisper-1
KIOSK_STT_MIN_CHARS=3
KIOSK_STT_MAX_UPLOAD_BYTES=8388608

# ───── Frontend (build-time) ─────
VITE_API_URL=
VITE_APP_NAME=Talk Box

# ───── Docker image tags (overridden by CI) ─────
IMAGE_BACKEND=ghcr.io/la-plas-growth/talkbox-backend:latest
IMAGE_FRONTEND=ghcr.io/la-plas-growth/talkbox-frontend:latest
